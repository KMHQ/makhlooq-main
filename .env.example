# ------------------------------------------------------------
# Site
# ------------------------------------------------------------

# Public site URL for OAuth redirects and absolute URLs (optional — defaults to https://kmhq.org)
NEXT_PUBLIC_SITE_URL=https://kmhq.org
# Base URL for Payload live preview (optional — defaults to https://kmhq.org)
NEXT_PUBLIC_SERVER_URL=

# ------------------------------------------------------------
# Payload
# ------------------------------------------------------------

# Signs Payload auth tokens and encrypts its secrets (required)
PAYLOAD_SECRET=

# ------------------------------------------------------------
# Database and uploads
# ------------------------------------------------------------

# Postgres connection string for Payload (Supabase → Connect → Session pooler)
# Special chars in password MUST be percent-encoded: ! → %21, ) → %29, @ → %40
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
# Folder for uploaded media and avatars (optional, defaults to the project root: ./media, ./avatars)
UPLOADS_DIR=

# ------------------------------------------------------------
# Discord
# ------------------------------------------------------------

# OAuth application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot for guild membership verification
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ------------------------------------------------------------
# Admin
# ------------------------------------------------------------

# Comma-separated Discord user IDs with super-admin access
ADMIN_DISCORD_IDS=
# Session secret for admin cookies (optional — falls back to DISCORD_CLIENT_SECRET)
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------
# FleetYards
# ------------------------------------------------------------

# Comma-separated fleet slugs shown before they have a DB row (optional)
FLEETYARDS_FLEET_SLUGS=
